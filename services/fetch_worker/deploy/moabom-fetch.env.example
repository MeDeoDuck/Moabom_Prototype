# Copy to /etc/moabom-fetch.env (chmod 640, owner root, group rtx4060ti).
# Generate the token with:
#   openssl rand -base64 32
# Then mirror the same value into Azure Container App as the
# fetch-worker-token secret.
FETCH_WORKER_TOKEN=replace-with-openssl-rand-output

# Scope classifier (GPU). Point to the fine-tuned klue/roberta-large checkpoint
# directory containing config.json + model.safetensors + tokenizer.json.
SCOPE_MODEL_DIR=/home/rtx4060ti/projects/scope-classifier/runs/klue-roberta-large/best
# SCOPE_BATCH_SIZE=16   # optional override

# Qwen3 embedding (GPU, /embed — v3 coarse_cluster). 모델은 HF 캐시에서 자동 로드.
# EMBED_MODEL_ID=Qwen/Qwen3-Embedding-4B   # default; HF id 또는 로컬 경로
# EMBED_BATCH_SIZE=16                       # optional override
# 워커 venv 에 sentence-transformers 설치 필요:
#   services/fetch_worker/.venv/bin/pip install sentence-transformers
